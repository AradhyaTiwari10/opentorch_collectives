# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables for SupplyChainSim
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# These variables are required by inference.py for running the baseline agent.
# ─────────────────────────────────────────────────────────────────────────────

# The API endpoint for the LLM (e.g. HuggingFace Inference Providers)
API_BASE_URL=https://router.huggingface.co/v1

# The model identifier to use for inference
MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct

# Your Hugging Face / API key
HF_TOKEN=hf_your_token_here

# The URL of the deployed HF Space environment
SPACE_URL=https://aradhya10-supply-chain-sim.hf.space
